<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标前景：抓包主题。

  构图：一根竖直的「链路」贯穿，上下各一个方向相反的箭头，
  表示 SSO 的请求 / 响应双向流动。整体在中心 64x64 安全区内。

  坐标（108 视口）：
    链路 x=54，从 y=32 到 y=76
    上箭头（发送，蓝色）朝上
    下箭头（接收，绿色）朝下
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- 主链路 -->
    <path
        android:pathData="M54,36 L54,72"
        android:strokeColor="#55FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round" />

    <!-- 上箭头：发送（蓝） -->
    <path
        android:pathData="M42,50 L54,34 L66,50"
        android:strokeColor="#FF6FA8FF"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 下箭头：接收（绿） -->
    <path
        android:pathData="M42,58 L54,74 L66,58"
        android:strokeColor="#FF5FD08A"
        android:strokeWidth="6"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- 左右两个数据节点，强化「抓包」意象 -->
    <path
        android:pathData="M30,54 A4,4 0 1,1 29.9,54 Z"
        android:fillColor="#FF6FA8FF" />
    <path
        android:pathData="M78,54 A4,4 0 1,1 77.9,54 Z"
        android:fillColor="#FF5FD08A" />

    <!-- 连接节点的细线 -->
    <path
        android:pathData="M34,54 L46,54 M62,54 L74,54"
        android:strokeColor="#44FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round" />
</vector>
