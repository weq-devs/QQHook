<?xml version="1.0" encoding="utf-8"?>
<!--
  自适应图标背景：品牌蓝紫斜向渐变。
  深色用 #1B2A4A → #3D2E6B，与 App 内 primary 色系呼应。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#FF1B2A4A" android:offset="0.0" />
                <item android:color="#FF2B3A6B" android:offset="0.55" />
                <item android:color="#FF3D2E6B" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- 右上角柔光，增加层次 -->
    <path android:pathData="M108,0 L108,54 A54,54 0 0,1 54,0 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="108"
                android:startY="0"
                android:endX="54"
                android:endY="54"
                android:type="radial"
                android:gradientRadius="70">
                <item android:color="#33FFFFFF" android:offset="0.0" />
                <item android:color="#00FFFFFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
